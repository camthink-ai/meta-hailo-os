 &gpio0 {
 	gpio-ranges = <&pinctrl 0 0 16>;
@@ -298,6 +316,13 @@
 &gpio1 {
 	gpio-ranges = <&pinctrl 0 16 16>;
 	gpio-line-names = GPIO_LINE_NAMES;
+	/*
+	 * EM05 (CN/E/G): GPIO21/22/23 named for userspace (gpio1 offsets
+	 * 5/6/7). Do NOT attach pinctrl-0 here — Hailo pinmux is strict; a
+	 * default state on the gpio controller claims the pins and blocks
+	 * gpiod/gpioset (gpioinfo shows "kernel input [used]"). Mux to GPIO
+	 * happens on request via gpiochip_generic_request.
+	 */
 };
 
