+		groups = "gpio22_grp";
+	};
+
+	pinctrl_gpio23: gpio23 {
+		function = "gpio";
+		groups = "gpio23_grp";
+	};
+
 	pinctrl_gpio27: gpio27 {
 		function = "gpio";
 		groups = "gpio27_grp";
 	};
 };
 
